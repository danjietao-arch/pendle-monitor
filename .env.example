# ===== Pendle 聪明钱监控 配置 =====
# 复制本文件为 .env 并填写以下三项即可运行

# Etherscan V2 免费 API Key（https://etherscan.io/apis 注册获取，一个 Key 查所有链）
ETHERSCAN_API_KEY=

# Telegram Bot Token（找 @BotFather 创建机器人获取，格式 123456:ABC-xxx）
TG_BOT_TOKEN=

# 接收通知的 Chat ID（找 @userinfobot 查询自己的 ID；群组则为负数）
TG_CHAT_ID=

# 运行模式: loop=本地常驻轮询(推荐) / once=单次执行(GitHub Actions 用)
RUN_MODE=loop

# 试运行模式: 1=只打印消息不真正发送 Telegram（测试用）
DRY_RUN=0
